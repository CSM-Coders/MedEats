# Copiar este archivo como .env y rellenar los valores reales.
# Generar DJANGO_SECRET_KEY con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_SECRET_KEY=genera-una-clave-segura-con-python-secrets
DJANGO_DEBUG=False
# En dev (DJANGO_DEBUG=True) ALLOWED_HOSTS es opcional — el default es "*"
# para facilitar pruebas en dispositivo físico. En prod es obligatorio.
ALLOWED_HOSTS=midominio.com,api.midominio.com
DB_NAME=medeats
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:8081
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
REDIS_URL=redis://localhost:6379/0
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-1
CLOUDFRONT_DOMAIN=
SENTRY_DSN=
ENVIRONMENT=development
